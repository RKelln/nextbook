{
  "title": "branches.json, the library's branches and where they are",
  "type": "object",
  "required": ["fetched", "source", "branches"],
  "additionalProperties": false,
  "properties": {
    "fetched": { "type": "string", "minLength": 10 },
    "source": { "type": "string", "minLength": 10 },
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "street", "lat", "lon"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "street": { "type": "string" },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
