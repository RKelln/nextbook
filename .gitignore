# Raw catalogue pages are fetched into a local cache, never committed. The slice is the artifact.
.cache/
data/raw/
*.tmp
*.part

# A person's own searches, from tools/find.py. Never committed.
data/found.json
app/data/found.js
# A workshop copy's flag. A stray one in the source tree would make every build practice-only.
app/data/workshop.js

# The helper's note, written by tools/inbox.py or tools/find.py. One machine's message to the
# page, not data: never committed, and never packed into a build.
app/data/inbox.js

# Built copies are made by tools/build.py, never edited, never committed.
dist/

# The live-reload note tools/serve.py reads: one screen name, written for a moment, never committed.
.dev-go

nextbook-live.json
.nextbook-mirror-*

# Python
__pycache__/
*.pyc

# Editor and OS noise
.DS_Store
.idea/
.vscode/
.pytest_cache/

# Design screenshots from tools/screens.py. Never committed.
screens/
